# /etc/logrotate.d/agent-app 로 복사해서 사용
# monitor.log 가 10MB 를 넘으면 monitor.log.1 로 이름을 바꾸고 새 파일을 만든다.
# 예전 파일은 10개(monitor.log.1 ~ monitor.log.10)까지만 두고, 그보다 오래된 것은 지운다.
/var/log/agent-app/monitor.log {
    size 10M
    rotate 10
    missingok
    notifempty
    create 0660 agent-admin agent-core
    su agent-admin agent-core
}
